{
  "use_bm25": true,
  "use_dense": true,
  "analyzer": {
    "lowercase": true,
    "remove_stopwords": true,
    "stem": false,
    "min_token_len": 2
  },
  "bm25": {
    "k1": 1.5,
    "b": 0.75
  },
  "dense": {
    "model_name": "sentence-transformers/all-MiniLM-L6-v2",
    "normalize": true,
    "max_seq_length": 256
  },
  "fusion": {
    "method": "weighted",
    "weight_bm25": 1.0,
    "weight_dense": 1.0,
    "rrf_k": 60.0,
    "candidate_k": 200
  },
  "rerank": {
    "enabled": false,
    "model_name": "cross-encoder/ms-marco-MiniLM-L-6-v2",
    "top_n": 100
  }
}